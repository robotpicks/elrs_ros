<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>elrs_driver</name>
  <version>0.1.0</version>
  <description>Generic ExpressLRS / CRSF (TBS Crossfire) receiver driver for ROS 2: RC channels over a UART -&gt; sensor_msgs/Joy, and sensor_msgs/BatteryState -&gt; telemetry back to the handset. Wire format is a pluggable codec (CRSF now, MAVLink-over-ELRS on the roadmap).</description>
  <maintainer email="nir@nadirwave.com">Nir Mor</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/robotpicks/elrs_ros</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
